# Copie para .env e ajuste. O .env não é versionado.
DB_NAME=goerp
DB_USERNAME=goerp
DB_PASSWORD=troque-esta-senha
# Chave para assinar os tokens (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Primeiro acesso: administrador da plataforma criado na primeira inicialização (se ainda não existir).
# Troque a senha logo após o primeiro login (POST /api/v1/autenticacao/senha).
GOERP_ADMIN_NOME=Administrador da Plataforma
GOERP_ADMIN_EMAIL=admin@goerp.local
GOERP_ADMIN_SENHA=troque-esta-senha-1

# Backup automático do banco (serviço "backup" do docker-compose)
# Agenda no formato cron (padrão: todo dia às 3h) e quantos backups manter
BACKUP_AGENDA=0 3 * * *
BACKUP_MANTER_DIAS=7
BACKUP_MANTER_SEMANAS=4
BACKUP_MANTER_MESES=6
BACKUP_PASTA=./backups
TZ=America/Sao_Paulo
